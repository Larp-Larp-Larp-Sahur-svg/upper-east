# Password for /admin. Required in production.
CMS_PASSWORD=

# Free production CMS (Supabase). Required on Vercel so client saves persist.
# 1. Create a project at https://supabase.com (free tier)
# 2. Run supabase/setup.sql in the SQL editor
# 3. Settings → API → copy Project URL and service_role key (not anon)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: local disk storage instead of Supabase (development default)
# CMS_CONTENT_DIR=/var/lib/upper-east/content
